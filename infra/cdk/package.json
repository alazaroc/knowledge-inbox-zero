{
  "name": "@app/infra",
  "version": "0.0.0",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --passWithNoTests",
    "cdk": "cdk",
    "deploy:test": "cdk deploy --all --context env=test --require-approval never",
    "deploy:prod": "cdk deploy --all --context env=prod"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.258.1",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/source-map-support": "^0.5.10",
    "aws-cdk": "^2.1126.0",
    "esbuild": "^0.25.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ]
  }
}
