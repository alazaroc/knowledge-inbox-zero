{
  "manifest_version": 3,
  "name": "Knowledge Inbox Zero — Save tab",
  "version": "1.0.0",
  "description": "One-click save of the current tab to your Knowledge Inbox Zero inbox. Uses your existing logged-in browser session — no token needed.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save this tab to Knowledge Inbox Zero",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "commands": {
    "save-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save the current tab to Knowledge Inbox Zero"
    }
  },
  "permissions": ["tabs", "storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "knowledge-inbox-zero@playingaws",
      "strict_min_version": "121.0"
    }
  }
}
