{
  "name": "read-worthy-mcp-server",
  "version": "1.0.1",
  "type": "module",
  "description": "MCP server exposing Read Worthy to any Kiro agent — a thin client of the deployed API (submit URLs, list recommendations, explain a document).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "read-worthy",
    "reading-list",
    "recommendations",
    "kiro"
  ],
  "homepage": "https://github.com/alazaroc/read-worthy/tree/main/mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alazaroc/read-worthy.git",
    "directory": "mcp-server"
  },
  "author": "Alejandro Lazaro Chueca",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "read-worthy-mcp-server": "dist/index.js",
    "kiz-login": "dist/login.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "login": "node dist/login.js",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1068.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
